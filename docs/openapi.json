{
  "openapi": "3.0.3",
  "info": {
    "title": "MyKELASI API",
    "description": "API REST v1 pour apprenants, formateurs et opérations internes. Fuseau métier : Africa/Kinshasa. Les montants sont des chaînes décimales en CDF.",
    "version": "1.0.0"
  },
  "servers": [{"url": "/api/v1"}],
  "tags": [
    {"name": "Système"},
    {"name": "Authentification"},
    {"name": "Profils"},
    {"name": "Vérification"},
    {"name": "Apprentissage"},
    {"name": "Réservations"},
    {"name": "Messagerie"},
    {"name": "Notifications"},
    {"name": "Avis"},
    {"name": "Paiements"},
    {"name": "Analytics"}
  ],
  "security": [{"bearerAuth": []}],
  "paths": {
    "/": {"get": {"tags": ["Système"], "summary": "Racine API v1", "security": [], "responses": {"200": {"description": "Version de l'API"}}}},
    "/auth/register/": {"post": {"tags": ["Authentification"], "summary": "Inscription", "description": "Payload : email, first_name, last_name, account_type, password, password_confirm. account_type vaut LEARNER ou TEACHER.", "security": [], "responses": {"201": {"description": "Compte créé"}, "400": {"$ref": "#/components/responses/ValidationError"}, "409": {"description": "Adresse déjà utilisée"}, "429": {"$ref": "#/components/responses/TooManyRequests"}}}},
    "/auth/login/": {"post": {"tags": ["Authentification"], "summary": "Connexion JWT", "description": "Payload : email, password et mfa_code pour un compte interne.", "security": [], "responses": {"200": {"description": "Jetons access et refresh"}, "401": {"$ref": "#/components/responses/Unauthorized"}, "429": {"$ref": "#/components/responses/TooManyRequests"}}}},
    "/auth/refresh/": {"post": {"tags": ["Authentification"], "summary": "Rafraîchir un JWT", "security": [], "responses": {"200": {"description": "Nouveaux jetons"}, "401": {"$ref": "#/components/responses/Unauthorized"}, "429": {"$ref": "#/components/responses/TooManyRequests"}}}},
    "/auth/logout/": {"post": {"tags": ["Authentification"], "summary": "Révoquer un refresh token", "description": "Payload : refresh.", "responses": {"204": {"description": "Jeton révoqué"}, "400": {"$ref": "#/components/responses/ValidationError"}, "401": {"$ref": "#/components/responses/Unauthorized"}}}},
    "/auth/verify-email/": {"post": {"tags": ["Authentification"], "summary": "Vérifier l'adresse e-mail", "description": "Payload : token.", "security": [], "responses": {"200": {"description": "Adresse vérifiée"}, "400": {"$ref": "#/components/responses/ValidationError"}, "429": {"$ref": "#/components/responses/TooManyRequests"}}}},
    "/auth/me/": {"get": {"tags": ["Authentification"], "summary": "Utilisateur connecté", "responses": {"200": {"description": "Profil courant"}, "401": {"$ref": "#/components/responses/Unauthorized"}}}},
    "/auth/internal/mfa/enroll/": {"post": {"tags": ["Authentification"], "summary": "Enrôler un dispositif MFA interne", "responses": {"201": {"description": "Dispositif et URI otpauth"}, "200": {"description": "Dispositif non confirmé existant"}, "403": {"$ref": "#/components/responses/Forbidden"}, "409": {"description": "MFA déjà confirmé"}}}},
    "/auth/internal/mfa/confirm/": {"post": {"tags": ["Authentification"], "summary": "Confirmer le MFA", "description": "Payload : code TOTP à 6 chiffres.", "responses": {"200": {"description": "MFA confirmé"}, "400": {"$ref": "#/components/responses/ValidationError"}, "403": {"$ref": "#/components/responses/Forbidden"}}}},
    "/auth/internal/support/": {"get": {"tags": ["Authentification"], "summary": "Tableau support interne", "responses": {"200": {"description": "Utilisateurs, demandes et réservations"}, "403": {"$ref": "#/components/responses/Forbidden"}}}},
    "/internal/referentials/{kind}/": {"get": {"tags": ["Référentiels"], "summary": "Lister les référentiels", "responses": {"200": {"$ref": "#/components/responses/Paginated"}, "403": {"$ref": "#/components/responses/Forbidden"}}}, "post": {"tags": ["Référentiels"], "summary": "Créer un référentiel", "description": "Réservé aux groupes ADMIN et SUPER_ADMIN. kind vaut subjects, levels, teaching-modes ou service-areas.", "responses": {"201": {"description": "Référentiel créé"}, "400": {"$ref": "#/components/responses/ValidationError"}, "403": {"$ref": "#/components/responses/Forbidden"}}}},
    "/internal/referentials/{kind}/{id}/": {"get": {"tags": ["Référentiels"], "summary": "Consulter un référentiel", "responses": {"200": {"description": "Référentiel"}, "403": {"$ref": "#/components/responses/Forbidden"}, "404": {"$ref": "#/components/responses/NotFound"}}}, "patch": {"tags": ["Référentiels"], "summary": "Modifier ou désactiver un référentiel", "responses": {"200": {"description": "Référentiel modifié"}, "400": {"$ref": "#/components/responses/ValidationError"}, "403": {"$ref": "#/components/responses/Forbidden"}}}, "delete": {"tags": ["Référentiels"], "summary": "Supprimer un référentiel inutilisé", "responses": {"204": {"description": "Référentiel supprimé"}, "403": {"$ref": "#/components/responses/Forbidden"}, "409": {"description": "Référentiel encore utilisé"}}}},
    "/internal/configurations/": {"get": {"tags": ["Référentiels"], "summary": "Lister les versions de configuration", "responses": {"200": {"$ref": "#/components/responses/Paginated"}, "403": {"$ref": "#/components/responses/Forbidden"}}}, "post": {"tags": ["Référentiels"], "summary": "Publier une version de configuration", "description": "Clés : matching_weights, payment_commission, currency, policies. Les versions publiées sont immuables.", "responses": {"201": {"description": "Version publiée"}, "400": {"$ref": "#/components/responses/ValidationError"}, "403": {"$ref": "#/components/responses/Forbidden"}}}},
    "/search/teachers/": {"get": {"tags": ["Profils"], "summary": "Rechercher des formateurs", "description": "Filtres : subject, level, teaching_mode, service_area, budget. Réponse paginée.", "security": [], "responses": {"200": {"$ref": "#/components/responses/Paginated"}}}},
    "/teachers/": {"get": {"tags": ["Profils"], "summary": "Lister les formateurs publics", "description": "Filtres : subject, level, teaching_mode, service_area, budget. Réponse paginée.", "security": [], "responses": {"200": {"$ref": "#/components/responses/Paginated"}}}},
    "/teachers/{public_id}/": {"get": {"tags": ["Profils"], "summary": "Détail public formateur", "security": [], "parameters": [{"$ref": "#/components/parameters/PublicId"}], "responses": {"200": {"description": "Profil public"}, "404": {"$ref": "#/components/responses/NotFound"}}}},
    "/teacher/profile/": {"get": {"tags": ["Profils"], "summary": "Profil formateur courant", "responses": {"200": {"description": "Profil privé"}}}, "put": {"tags": ["Profils"], "summary": "Remplacer le profil formateur", "responses": {"200": {"description": "Profil mis à jour"}, "400": {"$ref": "#/components/responses/ValidationError"}}}, "patch": {"tags": ["Profils"], "summary": "Modifier le profil formateur", "responses": {"200": {"description": "Profil mis à jour"}, "400": {"$ref": "#/components/responses/ValidationError"}}}},
    "/teacher/profile/catalog/": {"get": {"tags": ["Profils"], "summary": "Référentiels du formateur", "responses": {"200": {"description": "Matières, niveaux, modes et zones"}}}},
    "/teacher/availabilities/": {"get": {"tags": ["Profils"], "summary": "Lister les disponibilités", "responses": {"200": {"$ref": "#/components/responses/Paginated"}}}, "post": {"tags": ["Profils"], "summary": "Créer une disponibilité", "description": "Payload : weekday, start_time, end_time. La fin doit dépasser le début et les créneaux ne doivent pas se chevaucher.", "responses": {"201": {"description": "Disponibilité créée"}, "400": {"$ref": "#/components/responses/ValidationError"}}}},
    "/teacher/availabilities/{id}/": {"get": {"tags": ["Profils"], "summary": "Détail disponibilité", "parameters": [{"$ref": "#/components/parameters/Id"}], "responses": {"200": {"description": "Disponibilité"}}}, "put": {"tags": ["Profils"], "summary": "Remplacer disponibilité", "parameters": [{"$ref": "#/components/parameters/Id"}], "responses": {"200": {"description": "Disponibilité mise à jour"}}}, "patch": {"tags": ["Profils"], "summary": "Modifier disponibilité", "parameters": [{"$ref": "#/components/parameters/Id"}], "responses": {"200": {"description": "Disponibilité mise à jour"}}}, "delete": {"tags": ["Profils"], "summary": "Supprimer disponibilité", "parameters": [{"$ref": "#/components/parameters/Id"}], "responses": {"204": {"description": "Disponibilité supprimée"}}}},
    "/learner/profile/": {"get": {"tags": ["Profils"], "summary": "Profil apprenant courant", "responses": {"200": {"description": "Profil apprenant"}}}, "put": {"tags": ["Profils"], "summary": "Remplacer profil apprenant", "responses": {"200": {"description": "Profil mis à jour"}}}, "patch": {"tags": ["Profils"], "summary": "Modifier profil apprenant", "responses": {"200": {"description": "Profil mis à jour"}}}},
    "/learner/profile/catalog/": {"get": {"tags": ["Profils"], "summary": "Référentiels de l'apprenant", "responses": {"200": {"description": "Niveaux, matières, zones et modes"}}}},
    "/teacher/verifications/": {"get": {"tags": ["Vérification"], "summary": "Lister ses vérifications", "responses": {"200": {"$ref": "#/components/responses/Paginated"}}}, "post": {"tags": ["Vérification"], "summary": "Déposer une vérification", "description": "Multipart : kind, file, title. Formats PDF, JPEG, PNG ; taille maximale 5 MiB.", "responses": {"201": {"description": "Document créé"}, "400": {"$ref": "#/components/responses/ValidationError"}}}},
    "/verification/{kind}/{id}/review/": {"post": {"tags": ["Vérification"], "summary": "Décider sur un document", "description": "Payload : action (approve, reject, expire) et reason si nécessaire.", "responses": {"200": {"description": "Décision enregistrée"}, "403": {"$ref": "#/components/responses/Forbidden"}, "404": {"$ref": "#/components/responses/NotFound"}}}},
    "/verification/queue/": {"get": {"tags": ["Vérification"], "summary": "File des documents à vérifier", "responses": {"200": {"$ref": "#/components/responses/Paginated"}, "403": {"$ref": "#/components/responses/Forbidden"}}}},
    "/teacher/verifications/upload/": {"post": {"tags": ["Vérification"], "summary": "Initialiser un upload reprenable", "description": "Payload multipart : kind, name, size, content_type.", "responses": {"201": {"description": "Upload initialisé"}, "400": {"$ref": "#/components/responses/ValidationError"}}}},
    "/teacher/verifications/upload/{upload_id}/": {"get": {"tags": ["Vérification"], "summary": "Lire la progression d'un upload", "parameters": [{"$ref": "#/components/parameters/UploadId"}], "responses": {"200": {"description": "Offset reçu"}}}, "patch": {"tags": ["Vérification"], "summary": "Reprendre un upload", "description": "Header Upload-Offset et contenu du fragment.", "parameters": [{"$ref": "#/components/parameters/UploadId"}], "responses": {"201": {"description": "Document finalisé"}, "409": {"description": "Offset incorrect"}}}},
    "/requests/": {"get": {"tags": ["Apprentissage"], "summary": "Lister mes demandes", "responses": {"200": {"$ref": "#/components/responses/Paginated"}}}, "post": {"tags": ["Apprentissage"], "summary": "Créer une demande", "description": "Payload : subject, level, teaching_mode, service_area, budget, preferred_date, preferred_start_time, frequency, description. Date et heure sont cohérentes et la date est future.", "responses": {"201": {"description": "Demande et matches créés"}, "400": {"$ref": "#/components/responses/ValidationError"}}}},
    "/requests/{public_id}/": {"get": {"tags": ["Apprentissage"], "summary": "Détail d'une demande", "parameters": [{"$ref": "#/components/parameters/PublicId"}], "responses": {"200": {"description": "Demande"}, "403": {"$ref": "#/components/responses/Forbidden"}, "404": {"$ref": "#/components/responses/NotFound"}}}},
    "/requests/{public_id}/matches/": {"get": {"tags": ["Apprentissage"], "summary": "Matches d'une demande", "parameters": [{"$ref": "#/components/parameters/PublicId"}], "responses": {"200": {"description": "Matches et raisons de classement"}}}},
    "/requests/{public_id}/proposals/": {"get": {"tags": ["Apprentissage"], "summary": "Propositions liées à une demande", "parameters": [{"$ref": "#/components/parameters/PublicId"}], "responses": {"200": {"$ref": "#/components/responses/Paginated"}}}, "post": {"tags": ["Apprentissage"], "summary": "Créer une proposition autorisée", "description": "Payload : amount ou hourly_rate, message, availability.", "parameters": [{"$ref": "#/components/parameters/PublicId"}], "responses": {"201": {"description": "Proposition créée"}, "400": {"$ref": "#/components/responses/ValidationError"}, "409": {"description": "Proposition ou demande indisponible"}}}},
    "/proposals/{public_id}/{action}/": {"post": {"tags": ["Apprentissage"], "summary": "Accepter ou refuser une proposition", "description": "action vaut accept ou reject. Une seule proposition peut être acceptée.", "parameters": [{"$ref": "#/components/parameters/PublicId"}, {"name": "action", "in": "path", "required": true, "schema": {"type": "string", "enum": ["accept", "reject"]}}], "responses": {"200": {"description": "Transition enregistrée"}, "400": {"$ref": "#/components/responses/ValidationError"}, "409": {"description": "Transition concurrente ou proposition indisponible"}}}},
    "/teacher/matched-requests/": {"get": {"tags": ["Apprentissage"], "summary": "Demandes matchées du formateur", "responses": {"200": {"$ref": "#/components/responses/Paginated"}}}},
    "/teacher/proposals/": {"get": {"tags": ["Apprentissage"], "summary": "Propositions envoyées", "responses": {"200": {"$ref": "#/components/responses/Paginated"}}}, "post": {"tags": ["Apprentissage"], "summary": "Créer une proposition formateur", "responses": {"201": {"description": "Proposition créée"}, "400": {"$ref": "#/components/responses/ValidationError"}}}},
    "/teacher/proposals/{request_id}/": {"get": {"tags": ["Apprentissage"], "summary": "Proposition d'une demande", "parameters": [{"$ref": "#/components/parameters/Id"}], "responses": {"200": {"description": "Proposition"}}}, "post": {"tags": ["Apprentissage"], "summary": "Envoyer une proposition formateur", "parameters": [{"$ref": "#/components/parameters/Id"}], "responses": {"201": {"description": "Proposition créée"}}}},
    "/bookings/": {"get": {"tags": ["Réservations"], "summary": "Lister mes réservations", "responses": {"200": {"$ref": "#/components/responses/Paginated"}}}, "post": {"tags": ["Réservations"], "summary": "Créer une réservation", "description": "Payload : proposal_id, start_at, duration_minutes (30 à 480). Le prix est issu du serveur.", "responses": {"201": {"description": "Réservation créée"}, "400": {"$ref": "#/components/responses/ValidationError"}, "409": {"description": "Créneau déjà réservé"}}}},
    "/bookings/{public_id}/": {"get": {"tags": ["Réservations"], "summary": "Détail réservation", "parameters": [{"$ref": "#/components/parameters/PublicId"}], "responses": {"200": {"description": "Réservation, session et transitions"}, "403": {"$ref": "#/components/responses/Forbidden"}}}},
    "/bookings/{public_id}/action/": {"post": {"tags": ["Réservations"], "summary": "Effectuer une action de réservation", "description": "Payload : action parmi confirm, reject, cancel, mark_present, complete, learner_no_show, teacher_no_show, dispute.", "parameters": [{"$ref": "#/components/parameters/PublicId"}], "responses": {"200": {"description": "Transition enregistrée"}, "400": {"$ref": "#/components/responses/ValidationError"}, "403": {"$ref": "#/components/responses/Forbidden"}, "409": {"description": "Transition interdite ou conflit"}}}},
    "/conversations/": {"get": {"tags": ["Messagerie"], "summary": "Lister mes conversations", "responses": {"200": {"$ref": "#/components/responses/Paginated"}}}, "post": {"tags": ["Messagerie"], "summary": "Créer une conversation autorisée", "responses": {"201": {"description": "Conversation créée"}, "400": {"$ref": "#/components/responses/ValidationError"}}}},
    "/conversations/{public_id}/messages/": {"get": {"tags": ["Messagerie"], "summary": "Lire les messages", "parameters": [{"$ref": "#/components/parameters/PublicId"}], "responses": {"200": {"$ref": "#/components/responses/Paginated"}}}, "post": {"tags": ["Messagerie"], "summary": "Envoyer un message", "description": "Payload : body. Limite de débit messages : 30/minute.", "parameters": [{"$ref": "#/components/parameters/PublicId"}], "responses": {"201": {"description": "Message créé"}, "400": {"$ref": "#/components/responses/ValidationError"}, "403": {"$ref": "#/components/responses/Forbidden"}, "429": {"$ref": "#/components/responses/TooManyRequests"}}}},
    "/conversations/{public_id}/reports/": {"post": {"tags": ["Messagerie"], "summary": "Signaler une conversation ou un message", "description": "Payload : message_id, reason. Limite de débit : 5/heure.", "parameters": [{"$ref": "#/components/parameters/PublicId"}], "responses": {"201": {"description": "Signalement créé"}, "400": {"$ref": "#/components/responses/ValidationError"}, "429": {"$ref": "#/components/responses/TooManyRequests"}}}},
    "/notifications/": {"get": {"tags": ["Notifications"], "summary": "Lister mes notifications", "responses": {"200": {"$ref": "#/components/responses/Paginated"}}}},
    "/notifications/{id}/read/": {"post": {"tags": ["Notifications"], "summary": "Marquer une notification comme lue", "parameters": [{"$ref": "#/components/parameters/Id"}], "responses": {"200": {"description": "Notification lue"}, "403": {"$ref": "#/components/responses/Forbidden"}}}},
    "/notifications/read-all/": {"post": {"tags": ["Notifications"], "summary": "Tout marquer comme lu", "responses": {"204": {"description": "Notifications marquées"}}}},
    "/notification-preferences/": {"get": {"tags": ["Notifications"], "summary": "Lire mes préférences", "responses": {"200": {"description": "Préférences email, push, SMS et rappels"}}}, "put": {"tags": ["Notifications"], "summary": "Remplacer mes préférences", "responses": {"200": {"description": "Préférences mises à jour"}}}, "patch": {"tags": ["Notifications"], "summary": "Modifier mes préférences", "responses": {"200": {"description": "Préférences mises à jour"}}}},
    "/teachers/{teacher_id}/reviews/": {"get": {"tags": ["Avis"], "summary": "Avis publics d'un formateur", "security": [], "parameters": [{"$ref": "#/components/parameters/Id"}], "responses": {"200": {"$ref": "#/components/responses/Paginated"}}}},
    "/bookings/{booking_id}/reviews/": {"post": {"tags": ["Avis"], "summary": "Publier un avis", "description": "Payload : rating, comment, punctuality, communication, quality. Réservé à une session COMPLETED.", "parameters": [{"$ref": "#/components/parameters/Id"}], "responses": {"201": {"description": "Avis créé"}, "400": {"$ref": "#/components/responses/ValidationError"}, "409": {"description": "Avis déjà publié"}}}},
    "/teacher/reviews/": {"get": {"tags": ["Avis"], "summary": "Avis reçus du formateur", "responses": {"200": {"$ref": "#/components/responses/Paginated"}}}},
    "/teacher/reputation/": {"get": {"tags": ["Avis"], "summary": "Réputation du formateur", "responses": {"200": {"description": "Trust score et composantes"}}}},
    "/reviews/{review_id}/reply/": {"post": {"tags": ["Avis"], "summary": "Répondre à un avis", "description": "Payload : body.", "parameters": [{"$ref": "#/components/parameters/Id"}], "responses": {"201": {"description": "Réponse créée"}, "400": {"$ref": "#/components/responses/ValidationError"}}}},
    "/bookings/{booking_id}/payments/": {"post": {"tags": ["Paiements"], "summary": "Initier un paiement", "description": "Header obligatoire : Idempotency-Key. Le montant et la devise viennent de la réservation serveur.", "parameters": [{"$ref": "#/components/parameters/Id"}, {"$ref": "#/components/parameters/IdempotencyKey"}], "responses": {"200": {"description": "Paiement idempotent existant"}, "201": {"description": "Paiement initié"}, "400": {"$ref": "#/components/responses/ValidationError"}, "403": {"$ref": "#/components/responses/Forbidden"}}}},
    "/payments/": {"get": {"tags": ["Paiements"], "summary": "Lister mes paiements", "description": "Retourne uniquement les paiements dont l'utilisateur authentifié est le payeur.", "responses": {"200": {"$ref": "#/components/responses/Paginated"}, "401": {"$ref": "#/components/responses/Unauthorized"}}}},
    "/payments/{public_id}/": {"get": {"tags": ["Paiements"], "summary": "Détail d'un paiement autorisé", "parameters": [{"$ref": "#/components/parameters/PublicId"}], "responses": {"200": {"description": "Paiement"}, "403": {"$ref": "#/components/responses/Forbidden"}}}},
    "/payments/{public_id}/cancel/": {"post": {"tags": ["Paiements"], "summary": "Annuler un paiement en attente", "description": "Réservé au payeur. Uniquement possible tant que le statut est PENDING ; une nouvelle initiation utilisera une nouvelle clé d'idempotence.", "parameters": [{"$ref": "#/components/parameters/PublicId"}], "responses": {"200": {"description": "Paiement annulé"}, "400": {"$ref": "#/components/responses/ValidationError"}, "403": {"$ref": "#/components/responses/Forbidden"}, "404": {"$ref": "#/components/responses/NotFound"}}}},
    "/payments/webhook/": {"post": {"tags": ["Paiements"], "summary": "Webhook Mobile Money", "description": "Endpoint public protégé par X-Payment-Signature. Vérifie référence, montant, devise et rejeu.", "security": [], "parameters": [{"$ref": "#/components/parameters/PaymentSignature"}], "responses": {"200": {"description": "Webhook traité ou déjà traité"}, "400": {"$ref": "#/components/responses/ValidationError"}, "403": {"$ref": "#/components/responses/Forbidden"}}}},
    "/teacher/earnings/summary/": {"get": {"tags": ["Paiements"], "summary": "Résumé des revenus formateur", "responses": {"200": {"description": "Soldes et dernier versement"}}}},
    "/teacher/transactions/": {"get": {"tags": ["Paiements"], "summary": "Transactions formateur", "responses": {"200": {"$ref": "#/components/responses/Paginated"}}}},
    "/teacher/payouts/": {"get": {"tags": ["Paiements"], "summary": "Versements formateur", "responses": {"200": {"$ref": "#/components/responses/Paginated"}}}},
    "/analytics/": {"get": {"tags": ["Analytics"], "summary": "KPI produit", "description": "Accès admin. Filtres : from, to (YYYY-MM-DD), subject, service_area. Les KPI de conversion utilisent les sessions terminées.", "responses": {"200": {"description": "KPI"}, "403": {"$ref": "#/components/responses/Forbidden"}}}}
  },
  "components": {
    "securitySchemes": {"bearerAuth": {"type": "http", "scheme": "bearer", "bearerFormat": "JWT"}},
    "parameters": {
      "Id": {"name": "id", "in": "path", "required": true, "schema": {"type": "integer"}},
      "PublicId": {"name": "public_id", "in": "path", "required": true, "schema": {"type": "string", "format": "uuid"}},
      "UploadId": {"name": "upload_id", "in": "path", "required": true, "schema": {"type": "string", "format": "uuid"}},
      "IdempotencyKey": {"name": "Idempotency-Key", "in": "header", "required": true, "schema": {"type": "string", "maxLength": 255}},
      "PaymentSignature": {"name": "X-Payment-Signature", "in": "header", "required": true, "schema": {"type": "string"}}
    },
    "responses": {
      "Paginated": {"description": "Liste paginée uniforme", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/PaginatedResponse"}}}},
      "ValidationError": {"description": "Erreur de validation globale ou par champ", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}},
      "Unauthorized": {"description": "Authentification requise ou jeton invalide"},
      "Forbidden": {"description": "Permission insuffisante ou objet inaccessible"},
      "NotFound": {"description": "Objet introuvable"},
      "TooManyRequests": {"description": "Limite de débit dépassée"}
    },
    "schemas": {
      "Error": {"type": "object", "additionalProperties": true, "description": "Les clés peuvent être des noms de champs ou detail."},
      "PaginatedResponse": {"type": "object", "required": ["count", "next", "previous", "results"], "properties": {"count": {"type": "integer"}, "next": {"type": "string", "format": "uri", "nullable": true}, "previous": {"type": "string", "format": "uri", "nullable": true}, "results": {"type": "array", "items": {"type": "object"}}}},
      "DecimalAmount": {"type": "string", "pattern": "^[0-9]+\\.[0-9]{2}$", "example": "25000.00"},
      "IsoDateTime": {"type": "string", "format": "date-time", "description": "Date ISO 8601 avec fuseau Africa/Kinshasa"}
    }
  }
}
